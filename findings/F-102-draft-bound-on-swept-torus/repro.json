[
 ["variable.set", {"name": "bend_radius", "expr": "20 mm"}],
 ["variable.set", {"name": "bend_angle", "expr": "20 deg"}],
 ["sketch.create", {"name": "Rod path", "plane": "zx"}],
 ["sketch.path", {"sketch": "Rod path", "start": ["14 mm", "14 mm"], "segments": [
   {"line": ["14 mm", "26 mm"]},
   {"arc": ["14 mm + bend_radius * (1 - cos(bend_angle))", "26 mm + bend_radius * sin(bend_angle)"], "center": ["14 mm + bend_radius", "26 mm"], "clockwise": true},
   {"line": ["14 mm + bend_radius * (1 - cos(bend_angle)) + 40 mm * sin(bend_angle)", "26 mm + bend_radius * sin(bend_angle) + 40 mm * cos(bend_angle)"]}]}],
 ["sketch.create", {"name": "Rod section", "plane": "yz", "offset": "14 mm"}],
 ["sketch.path", {"sketch": "Rod section", "start": ["5 mm", "14 mm"], "segments": [{"arc": ["-5 mm", "14 mm"], "center": ["0 mm", "14 mm"]}, {"arc": "start", "center": ["0 mm", "14 mm"]}]}],
 ["feature.sweep", {"sketch": "Rod section", "path": "Rod path", "name": "Bent rod"}],
 ["measure.draft", {"faces": {"kind": "face", "where": {"name": "F3:side(e4,e6)"}}, "direction": "z", "minDraft": 1}]
