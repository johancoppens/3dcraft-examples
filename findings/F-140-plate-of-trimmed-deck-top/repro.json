 ["variable.set", {"name": "corner_radius", "expr": "3 in"}],
 ["variable.set", {"name": "tip_centre", "expr": "deck_length / 2 - tip_radius"}],
 ["variable.set", {"name": "corner_offset", "expr": "deck_width / 2 - corner_radius"}],
