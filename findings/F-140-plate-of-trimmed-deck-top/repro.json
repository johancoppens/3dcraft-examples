 ["variable.set", {"name": "kick_angle", "expr": "20 deg"}],
 ["variable.set", {"name": "kick_transition", "expr": "2 in"}],
 ["variable.set", {"name": "flat_half", "expr": "wheelbase / 2 + 2.125 in + 0.5 in"}],
