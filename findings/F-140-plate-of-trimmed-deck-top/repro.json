 ["variable.set", {"name": "sheet_half_width", "expr": "5 in"}],
 ["variable.set", {"name": "kick_end_rise", "expr": "tan(kick_angle) * (sheet_half_length - flat_half - kick_transition / 2)"}],
 ["variable.set", {"name": "rail_rise", "expr": "concave_depth * (sheet_half_width / (deck_width / 2))^2"}],
 ["sketch.create", {"name": "Left rail line", "plane": "zx", "offset": "-sheet_half_width"}],
 ["sketch.curve", {"sketch": "Left rail line", "x": "if(t > flat_half, if(t - flat_half < kick_transition, tan(kick_angle) * kick_transition * ((t - flat_half) / kick_transition)^3 * (1 - (t - flat_half) / kick_transition / 2), tan(kick_angle) * (t - flat_half - kick_transition / 2)), if(t < -flat_half, if(-t - flat_half < kick_transition, tan(kick_angle) * kick_transition * ((-t - flat_half) / kick_transition)^3 * (1 - (-t - flat_half) / kick_transition / 2), tan(kick_angle) * (-t - flat_half - kick_transition / 2)), 0 in)) + rail_rise", "y": "t", "t": ["-sheet_half_length", "sheet_half_length"]}],
 ["sketch.create", {"name": "Centre line", "plane": "zx", "offset": "0 in"}],
 ["sketch.curve", {"sketch": "Centre line", "x": "if(t > flat_half, if(t - flat_half < kick_transition, tan(kick_angle) * kick_transition * ((t - flat_half) / kick_transition)^3 * (1 - (t - flat_half) / kick_transition / 2), tan(kick_angle) * (t - flat_half - kick_transition / 2)), if(t < -flat_half, if(-t - flat_half < kick_transition, tan(kick_angle) * kick_transition * ((-t - flat_half) / kick_transition)^3 * (1 - (-t - flat_half) / kick_transition / 2), tan(kick_angle) * (-t - flat_half - kick_transition / 2)), 0 in))", "y": "t", "t": ["-sheet_half_length", "sheet_half_length"]}],
 ["sketch.create", {"name": "Right rail line", "plane": "zx", "offset": "sheet_half_width"}],
 ["sketch.curve", {"sketch": "Right rail line", "x": "if(t > flat_half, if(t - flat_half < kick_transition, tan(kick_angle) * kick_transition * ((t - flat_half) / kick_transition)^3 * (1 - (t - flat_half) / kick_transition / 2), tan(kick_angle) * (t - flat_half - kick_transition / 2)), if(t < -flat_half, if(-t - flat_half < kick_transition, tan(kick_angle) * kick_transition * ((-t - flat_half) / kick_transition)^3 * (1 - (-t - flat_half) / kick_transition / 2), tan(kick_angle) * (-t - flat_half - kick_transition / 2)), 0 in)) + rail_rise", "y": "t", "t": ["-sheet_half_length", "sheet_half_length"]}],
 ["sketch.create", {"name": "Tail end", "plane": "yz", "offset": "-sheet_half_length"}],
 ["sketch.curve", {"sketch": "Tail end", "x": "t", "y": "kick_end_rise + concave_depth * (t / (deck_width / 2))^2", "t": ["-sheet_half_width", "sheet_half_width"]}],
 ["sketch.create", {"name": "Nose end", "plane": "yz", "offset": "sheet_half_length"}],
 ["sketch.curve", {"sketch": "Nose end", "x": "t", "y": "kick_end_rise + concave_depth * (t / (deck_width / 2))^2", "t": ["-sheet_half_width", "sheet_half_width"]}],
 ["feature.surface.network", {"u": ["Left rail line", "Centre line", "Right rail line"], "v": ["Tail end", "Nose end"], "name": "Top surface"}],
 ["variable.set", {"name": "ply_thickness", "expr": "1 in / 16"}],
