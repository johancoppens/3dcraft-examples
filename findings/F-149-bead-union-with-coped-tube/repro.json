[
 ["document.setTolerance", {"linear": 0.001}],
 ["variable.set", {"name": "brace_angle", "expr": "0.8888548606027775 rad"}],
 ["variable.set", {"name": "foot_x", "expr": "506.43675483966774 mm"}],
 ["feature.cylinder", {"radius": "57.15 mm", "height": "1000 mm", "position": ["0 mm", 0, 0], "axis": [1, 0, 0], "name": "Chord"}],
 ["feature.cylinder", {"radius": "57.15 mm", "height": "1000 mm", "position": ["400 mm", 0, "600 mm"], "axis": [1, 0, 0], "name": "Upper chord"}],
 ["datum.plane", {"from": "yz", "about": "y", "angle": "-brace_angle", "name": "Square plane"}],
 ["datum.plane", {"from": "Square plane", "distance": "foot_x * cos(brace_angle)", "name": "Foot plane"}],
 ["sketch.create", {"name": "Tube section", "plane": "Foot plane"}],
 ["sketch.circle", {"sketch": "Tube section", "center": ["0 mm", "-foot_x * sin(brace_angle)"], "radius": "30.15 mm"}],
 ["sketch.circle", {"sketch": "Tube section", "center": ["0 mm", "-foot_x * sin(brace_angle)"], "radius": "26.15 mm"}],
 ["feature.extrude", {"sketch": "Tube section", "distance": "600 mm / sin(brace_angle)", "name": "Tube"}],
 ["feature.boolean", {"op": "subtract", "target": "Tube", "tool": "Chord", "keepTool": true, "name": "Tube coped at foot"}],
 ["feature.boolean", {"op": "subtract", "target": "Tube coped at foot", "tool": "Upper chord", "name": "Coped tube"}],
 ["sketch.create", {"name": "Tube outline", "plane": "Foot plane"}],
 ["sketch.circle", {"sketch": "Tube outline", "center": ["0 mm", "-foot_x * sin(brace_angle)"], "radius": "30.15 mm"}],
 ["feature.extrude", {"sketch": "Tube outline", "distance": "300 mm / sin(brace_angle)", "name": "Solid tube"}],
 ["feature.boolean", {"op": "union", "target": "Solid tube", "tool": "Chord", "name": "Joint"}],
 ["feature.transform", {"source": "Joint", "keep": true, "name": "Joint copy"}],
 ["feature.chamfer", {"edges": [["Joint copy:copy(0)/Solid tube:side(e2)", "Joint copy:copy(0)/Joint:copy(1)/Chord:face(0)"]], "distance": "10 mm", "name": "Welded joint"}],
 ["feature.boolean", {"op": "subtract", "target": "Welded joint", "tool": "Joint", "name": "Weld"}],
 ["feature.boolean", {"op": "union", "target": "Coped tube", "tool": "Weld", "name": "Tube with its weld"}],
 ["document.check", {}]
]
