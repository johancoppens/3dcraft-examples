 ["feature.chamfer", {"edges": [["F2:side(e37)", "F2:startCap(e4[*],e6[*],e9[*],e11[*],e13[*],e15[*],e17[*],e19[*],e21[*],e23[*],e25[*],e27[*],e30[*],e32[*],e35[*])"], ["F2:side(e37)", "F2:endCap(e4[*],e6[*],e9[*],e11[*],e13[*],e15[*],e17[*],e19[*],e21[*],e23[*],e25[*],e27[*],e30[*],e32[*],e35[*])"]], "distance": "(tap_major_diameter - core_bore) / 2", "name": "Countersunk thread entries"}],
