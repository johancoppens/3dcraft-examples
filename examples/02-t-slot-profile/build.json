 ["variable.set", {"name": "die_corner_radius", "expr": "0.3 mm"}],
 ["variable.set", {"name": "catalogue_area", "expr": "332 * (1 mm)^2"}],
 ["variable.set", {"name": "catalogue_ix", "expr": "28300 * (1 mm)^4"}],
 ["variable.set", {"name": "half_width", "expr": "profile_width / 2"}],
 ["variable.set", {"name": "lip_level", "expr": "half_width - wall_thickness"}],
 ["variable.set", {"name": "slot_floor_level", "expr": "half_width - slot_depth"}],
 ["variable.set", {"name": "slot_floor_width", "expr": "2 * (slot_floor_level - wall_thickness / sqrt(2))"}],
 ["variable.set", {"name": "flank_height", "expr": "(undercut_width - slot_floor_width) / 2"}],
 ["variable.set", {"name": "flank_top_level", "expr": "slot_floor_level + flank_height"}],
 ["variable.set", {"name": "corner_hole_offset", "expr": "(profile_width + undercut_width) / 4"}],
 ["variable.set", {"name": "corner_hole_diameter", "expr": "half_width - undercut_width / 2 - 2 * minimum_wall"}],
 ["variable.set", {"name": "slot_polar_moment", "expr": "slot_opening^3 / 12 * wall_thickness + slot_opening * (half_width^3 - lip_level^3) / 3 + undercut_width^3 / 12 * (lip_level - flank_top_level) + undercut_width * (lip_level^3 - flank_top_level^3) / 3 + ((undercut_width / 2)^4 - (slot_floor_width / 2)^4) / 6 + slot_floor_width * slot_floor_level^2 * flank_height + (slot_floor_width * slot_floor_level + slot_floor_level^2) * flank_height^2 + (slot_floor_width + 4 * slot_floor_level) * flank_height^3 / 3 + flank_height^4 / 2"}],
 ["variable.set", {"name": "rounds_polar_moment", "expr": "4 * (2 * corner_radius^4 * (1 / 3 - pi / 16) + 2 * corner_radius^3 * (half_width - corner_radius) / 3 + 2 * corner_radius^2 * (1 - pi / 4) * (half_width - corner_radius)^2) + 8 * (2 * mouth_radius^4 * (1 / 3 - pi / 16) + mouth_radius^3 * (half_width - slot_opening / 2 - 2 * mouth_radius) / 3 + mouth_radius^2 * (1 - pi / 4) * ((slot_opening / 2 + mouth_radius)^2 + (half_width - mouth_radius)^2)) - 8 * (die_corner_radius^3 * (undercut_width / 2 + slot_opening / 2 + 2 * lip_level) / 3 + die_corner_radius^2 * (1 - pi / 4) * ((undercut_width / 2 - die_corner_radius)^2 + (lip_level - die_corner_radius)^2 - (slot_opening / 2 + die_corner_radius)^2 - (lip_level + die_corner_radius)^2) + 2 * die_corner_radius^4 * (tan(22.5 deg) * (2 + 1 / cos(22.5 deg)^2) / 6 - pi / 16) + 2 * die_corner_radius^3 * (tan(22.5 deg) * (cos(22.5 deg) + 1 / cos(22.5 deg)) / 3 - 2 * sin(22.5 deg) / 3) * ((undercut_width / 2 - die_corner_radius) * cos(22.5 deg) - (flank_top_level + die_corner_radius * tan(22.5 deg)) * sin(22.5 deg) + (slot_floor_width / 2 - die_corner_radius * tan(22.5 deg)) * sin(22.5 deg) - (slot_floor_level + die_corner_radius) * cos(22.5 deg)) + die_corner_radius^2 * (tan(22.5 deg) - pi / 8) * ((undercut_width / 2 - die_corner_radius)^2 + (flank_top_level + die_corner_radius * tan(22.5 deg))^2 + (slot_floor_width / 2 - die_corner_radius * tan(22.5 deg))^2 + (slot_floor_level + die_corner_radius)^2))"}],
 ["variable.set", {"name": "section_area_closed_form", "expr": "profile_width^2 - (4 * corner_radius^2 + 8 * mouth_radius^2) * (1 - pi / 4) + 16 * die_corner_radius^2 * (tan(22.5 deg) - pi / 8) - pi * core_bore^2 / 4 - pi * corner_hole_diameter^2 - 4 * (slot_opening * wall_thickness + undercut_width * (lip_level - flank_top_level) + (undercut_width + slot_floor_width) / 2 * flank_height)"}],
 ["variable.set", {"name": "section_ix_closed_form", "expr": "(profile_width^4 / 6 - rounds_polar_moment - pi * core_bore^4 / 32 - 4 * (pi * corner_hole_diameter^4 / 32 + pi * corner_hole_diameter^2 / 2 * corner_hole_offset^2) - 4 * slot_polar_moment) / 2"}],
 ["sketch.create", {"name": "Cross section", "plane": "yz"}],
 ["sketch.path", {"sketch": "Cross section", "start": ["half_width - corner_radius * (1 - cos(45 deg))", "half_width - corner_radius * (1 - cos(45 deg))"], "segments": [{"arc": ["half_width - corner_radius", "half_width"], "center": ["half_width - corner_radius", "half_width - corner_radius"]}, {"line": ["slot_opening / 2 + mouth_radius", "half_width"]}, {"arc": ["slot_opening / 2", "half_width - mouth_radius"], "center": ["slot_opening / 2 + mouth_radius", "half_width - mouth_radius"]}, {"line": ["slot_opening / 2", "lip_level"]}, {"line": ["undercut_width / 2", "lip_level"]}, {"line": ["undercut_width / 2", "flank_top_level"]}, {"line": ["slot_floor_width / 2", "slot_floor_level"]}, {"line": ["-slot_floor_width / 2", "slot_floor_level"]}, {"line": ["-undercut_width / 2", "flank_top_level"]}, {"line": ["-undercut_width / 2", "lip_level"]}, {"line": ["-slot_opening / 2", "lip_level"]}, {"line": ["-slot_opening / 2", "half_width - mouth_radius"]}, {"arc": ["-slot_opening / 2 - mouth_radius", "half_width"], "center": ["-slot_opening / 2 - mouth_radius", "half_width - mouth_radius"]}, {"line": ["corner_radius - half_width", "half_width"]}, {"arc": ["corner_radius * (1 - cos(45 deg)) - half_width", "half_width - corner_radius * (1 - cos(45 deg))"], "center": ["corner_radius - half_width", "half_width - corner_radius"]}]}],
 ["sketch.pattern", {"sketch": "Cross section", "entities": ["e4", "e6", "e9", "e11", "e13", "e15", "e17", "e19", "e21", "e23", "e25", "e27", "e30", "e32", "e35"], "chain": ["e1", "e33"], "angle": "90 deg", "center": [0, 0], "count": 4}],
 ["sketch.circle", {"sketch": "Cross section", "center": [0, "0 mm"], "radius": "core_bore / 2"}],
