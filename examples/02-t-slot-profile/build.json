 ["feature.fillet", {"edges": [["F2:side(e13)", "F2:side(e15)"], ["F2:side(e15)", "F2:side(e17)"], ["F2:side(e17)", "F2:side(e19)"], ["F2:side(e19)", "F2:side(e21)"], ["F2:side(e21)", "F2:side(e23)"], ["F2:side(e23)", "F2:side(e25)"], ["F2:side(e11)", "F2:side(e13)"], ["F2:side(e25)", "F2:side(e27)"], ["F2:side(e13[1])", "F2:side(e15[1])"], ["F2:side(e15[1])", "F2:side(e17[1])"], ["F2:side(e17[1])", "F2:side(e19[1])"], ["F2:side(e19[1])", "F2:side(e21[1])"], ["F2:side(e21[1])", "F2:side(e23[1])"], ["F2:side(e23[1])", "F2:side(e25[1])"], ["F2:side(e11[1])", "F2:side(e13[1])"], ["F2:side(e25[1])", "F2:side(e27[1])"], ["F2:side(e13[2])", "F2:side(e15[2])"], ["F2:side(e15[2])", "F2:side(e17[2])"], ["F2:side(e17[2])", "F2:side(e19[2])"], ["F2:side(e19[2])", "F2:side(e21[2])"], ["F2:side(e21[2])", "F2:side(e23[2])"], ["F2:side(e23[2])", "F2:side(e25[2])"], ["F2:side(e11[2])", "F2:side(e13[2])"], ["F2:side(e25[2])", "F2:side(e27[2])"], ["F2:side(e13[3])", "F2:side(e15[3])"], ["F2:side(e15[3])", "F2:side(e17[3])"], ["F2:side(e17[3])", "F2:side(e19[3])"], ["F2:side(e19[3])", "F2:side(e21[3])"], ["F2:side(e21[3])", "F2:side(e23[3])"], ["F2:side(e23[3])", "F2:side(e25[3])"], ["F2:side(e11[3])", "F2:side(e13[3])"], ["F2:side(e25[3])", "F2:side(e27[3])"]], "radius": "die_corner_radius", "name": "Die corner rounds"}],
 ["feature.thread", {"face": "F2:side(e37)", "start": "F2:startCap(e4[*],e6[*],e9[*],e11[*],e13[*],e15[*],e17[*],e19[*],e21[*],e23[*],e25[*],e27[*],e30[*],e32[*],e35[*])", "length": "thread_depth", "name": "Tapped first end"}],
