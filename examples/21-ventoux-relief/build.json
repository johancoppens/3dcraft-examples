"expr": "3 mm"
}
],
[
"variable.set",
{
"name": "bottom_edge_break",
"expr": "1 mm"
}
],
[
"variable.set",
{
"name": "stack_base_level",
"expr": "floor(345 m / contour_interval) * contour_interval"
}
],
[
"variable.set",
{
"name": "contour_layer_count",
"expr": "floor((summit_elevation - stack_base_level) / contour_interval) + 1"
}
