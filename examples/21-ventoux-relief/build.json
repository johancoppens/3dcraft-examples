"assert.add",
{
"name": "Terrain volume from the data's mean height",
"measure": "volume",
"of": "Terrain",
"eq": "relief_width * relief_depth * data_mean_elevation * vertical_scale",
"tol": "0.001 * relief_width * relief_depth * data_mean_elevation * vertical_scale"
}
],
[
"assert.add",
{
"name": "Summit at the data's height",
"measure": "boxMax",
"of": "Summit probe",
"axis": "z",
"min": "(summit_elevation - 2 m) * vertical_scale",
"max": "(summit_elevation + 2 m) * vertical_scale"
}
],
[
"assert.add",
{
"name": "Start of the climb at the road's height",
"measure": "boxMax",
"of": "Start probe",
"axis": "z",
"min": "(climb_start_altitude - srtm_accuracy) * vertical_scale",
"max": "(climb_start_altitude + srtm_accuracy) * vertical_scale"
}
],
[
"assert.add",
{
"name": "Sixteen kilometre pins",
"measure": "count",
"of": {
"kind": "face",
"where": {
"in": "Kilometre pins",
"surface": "cylinder"
}
},
"eq": "16",
"when": "product == 1"
}
],
