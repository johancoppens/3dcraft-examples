[
[
"document.setTolerance",
{
"linear": 0.001
}
],
[
"variable.set",
{
"name": "vertical_exaggeration",
"expr": "2.1"
}
],
[
"variable.set",
{
"name": "contour_interval",
"expr": "100 m"
}
],
[
"variable.set",
{
"name": "product",
"expr": "1"
}
],
[
"variable.publish",
{
"name": "vertical_exaggeration",
"label": "Vertical exaggeration",
"description": "How many times taller than the map's scale the printed relief's heights are drawn (the laser-cut layers take theirs from the sheet thickness)",
"group": "Relief",
"order": 1,
"kind": "number",
"min": "1",
"max": "3",
"step": "0.1"
}
],
[
"variable.publish",
{
"name": "contour_interval",
"label": "Contour interval",
"description": "Height between the laser-cut contour layers, one 3 mm sheet each, counted from sea level",
"group": "Relief",
"order": 2,
"kind": "number",
"min": "100 m",
"max": "200 m",
"step": "50 m",
"unit": "m"
}
],
[
"variable.publish",
{
"name": "product",
"label": "Product",
"description": "A relief 3D-printed in two colours with brass kilometre pins, or a stack of laser-cut contour layers",
"group": "Relief",
"order": 3,
"kind": "choice",
"choices": [
"Printed relief",
"Laser-cut layers"
]
}
],
[
"variable.set",
{
"name": "map_scale",
"expr": "70000"
}
],
[
"variable.set",
{
"name": "sheet_thickness",
"expr": "3 mm"
}
],
[
"variable.set",
{
"name": "vertical_scale",
"expr": "if(product == 2, sheet_thickness / contour_interval, vertical_exaggeration / map_scale)"
}
],
[
"variable.set",
{
"name": "node_pitch",
"expr": "250 m / map_scale"
}
],
[
"variable.set",
{
"name": "relief_width",
"expr": "50 * node_pitch"
}
],
[
"variable.set",
{
"name": "relief_depth",
"expr": "39 * node_pitch"
}
],
[
"variable.set",
{
"name": "summit_elevation",
"expr": "1910 m"
}
],
[
"variable.set",
{
"name": "blank_height",
"expr": "summit_elevation * vertical_scale + 10 mm"
}
],
[
"variable.set",
{
"name": "forest_edge_elevation",
"expr": "1419.1 m"
}
],
[
"variable.set",
{
"name": "data_mean_elevation",
"expr": "1030.6 m"
}
],
[
"variable.set",
{
"name": "climb_start_altitude",
"expr": "544.4 m"
}
],
[
"variable.set",
{
"name": "srtm_accuracy",
"expr": "16 m"
}
],
[
"variable.set",
{
"name": "pin_diameter",
"expr": "1.5 mm"
}
],
[
"variable.set",
{
"name": "start_pin_diameter",
"expr": "2.5 mm"
}
],
[
"variable.set",
{
"name": "pin_hole_clearance",
"expr": "0.1 mm"
}
],
[
"variable.set",
{
"name": "pin_protrusion",
"expr": "2 mm"
}
],
[
"variable.set",
{
"name": "hole_floor",
"expr": "3 mm"
}
],
[
"variable.set",
{
"name": "landmark_scale",
"expr": "10"
}
],
[
"variable.set",
{
"name": "tower_height",
"expr": "44.8 m"
}
],
[
"variable.set",
{
"name": "tower_diameter",
"expr": "sqrt(162.3 * 4 / pi) * 1 m"
}
],
[
"variable.set",
{
"name": "tower_ground",
"expr": "1893.5 m"
}
],
[
"variable.set",
{
"name": "mast_top",
"expr": "1975.5 m"
}
],
[
"variable.set",
{
"name": "mast_diameter",
"expr": "0.6 mm"
}
],
[
"variable.set",
{
"name": "tower_roof",
"expr": "tower_ground * vertical_scale + landmark_scale * tower_height / map_scale"
}
],
[
"variable.set",
{
"name": "mast_length",
"expr": "landmark_scale * (mast_top - tower_ground - tower_height) / map_scale"
}
],
[
"variable.set",
{
"name": "base_border",
"expr": "15 mm"
}
],
[
"variable.set",
{
"name": "base_thickness",
