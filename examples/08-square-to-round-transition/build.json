 ["variable.measure", {"name": "steel_mass", "measure": "mass", "of": ["Transition quarter 1", "Transition quarter 2", "Transition quarter 3", "Transition quarter 4", "Rectangular straight", "Round straight", "Collar", "Flange frame", "Spigot"], "label": "Mass of the steel parts", "unit": "kg"}],
 ["assert.add", {"name": "Transition is developable", "measure": "developable", "of": "Middle piece sheet", "is": true}],
 ["assert.add", {"name": "Zero Gaussian curvature", "measure": "curvature", "of": "Middle piece sheet", "max": "1e-12"}],
 ["assert.add", {"name": "Plated sheet is the same developable", "measure": "developable", "of": "Inside quarter sheet", "is": true}],
 ["assert.add", {"name": "Flat pattern keeps the area", "measure": "area", "of": "Middle piece sheet", "eq": "pattern_area", "tol": "0.01"}],
 ["assert.add", {"name": "Flat triangles and flaps in closed form", "measure": "area", "of": {"kind": "face", "where": {"in": "Middle piece sheet", "surface": "plane"}}, "eq": "flat_area + flap_area", "tol": "0.01"}],
 ["assert.add", {"name": "Cone corner by quadrature", "measure": "area", "of": {"kind": "face", "where": {"in": "Middle piece sheet", "not": {"surface": "plane"}}}, "eq": "corner_area", "tol": "0.05"}],
 ["assert.add", {"name": "Pattern is the plate's middle layer", "measure": "value", "expr": "quarter_volume / sheet_thickness", "eq": "pattern_area - flap_area", "tol": "0.002 * pattern_area"}],
 ["assert.add", {"name": "Sheet meets EN 1507 class S", "measure": "value", "expr": "sheet_thickness", "min": "class_s_minimum_sheet"}],
 ["assert.add", {"name": "Collar laps the straight", "measure": "overlap", "of": "Collar", "to": "Rectangular straight", "is": false}],
