 ["assert.add", {"name": "Bolt holes clear of the bend", "measure": "distance", "from": {"kind": "face", "where": {"in": "Flange frame", "hole": true}}, "to": {"kind": "face", "where": {"in": "Flange frame", "name": "*F53:side*"}}, "min": "2.5 * frame_sheet_thickness + frame_sheet_thickness"}],
 ["assert.add", {"name": "Flat pattern clear of the frame", "measure": "boxMax", "of": "Flat pattern", "axis": "y", "max": "-half_height - sheet_thickness - flange_width"}],
 ["document.info", {"title": "Square-to-round transition", "description": "A four-piece sheet-metal transition from a rectangular duct (EN 1505) to a round duct (EN 1506): flat triangles and developable cone corners in 0.8 mm galvanised steel with straight ends, one piece unfolded into the flat pattern cut four times, with a collar and P20 angle frame lapped over the rectangular straight and a sealed spigot lapped into the round straight.", "author": "3DCraft examples", "licence": "MIT", "tags": ["sheet metal", "HVAC", "developable", "flat pattern", "EN 1505", "EN 1506"]}],
