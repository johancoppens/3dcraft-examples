 ["assert.add", {"name": "Spigot within EN 1506", "measure": "extent", "of": "Spigot", "axis": "x", "min": "en_1506[round_size].spigot_min", "max": "en_1506[round_size].spigot_max"}],
 ["assert.add", {"name": "Seal reaches the duct wall", "measure": "extent", "of": "Lip seal", "axis": "x", "min": "en_1506[round_size].duct_max + 2 mm"}],
 ["assert.add", {"name": "Overall length", "measure": "extent", "of": ["Collar", "Flange frame", "Spigot"], "axis": "z", "eq": "fitting_length", "tol": "0.001"}],
