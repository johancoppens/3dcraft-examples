[
 ["variable.set", {"name": "ring_size", "expr": "54"}],
 ["variable.set", {"name": "carat", "expr": "1"}],
 ["variable.publish", {"name": "ring_size", "label": "Ring size", "description": "ISO 8653 ring size: the inner circumference in millimetres", "group": "Ring", "order": 1, "kind": "integer", "min": "44", "max": "72", "step": "1"}],
 ["variable.publish", {"name": "carat", "label": "Carat", "description": "Weight of the round brilliant in metric carats (0.2 g)", "group": "Stone", "order": 2, "min": "0.25", "max": "2", "step": "0.05"}],
 ["variable.set", {"name": "table_ratio", "expr": "0.53"}],
 ["variable.set", {"name": "crown_angle", "expr": "34.5 deg"}],
 ["variable.set", {"name": "pavilion_angle", "expr": "40.75 deg"}],
 ["variable.set", {"name": "star_ratio", "expr": "0.5"}],
 ["variable.set", {"name": "lower_half_ratio", "expr": "0.75"}],
 ["variable.set", {"name": "girdle_ratio", "expr": "0.03"}],
 ["variable.set", {"name": "diamond_density", "expr": "3.515 g / (1 cm)^3"}],
 ["variable.set", {"name": "star_point", "expr": "table_ratio * cos(22.5 deg) + star_ratio * (1 - table_ratio * cos(22.5 deg))"}],
 ["variable.set", {"name": "crown_rise", "expr": "(1 - table_ratio) * tan(crown_angle)"}],
 ["variable.set", {"name": "star_rise", "expr": "(1 - star_point * cos(22.5 deg)) * tan(crown_angle)"}],
 ["variable.set", {"name": "lower_drop", "expr": "(1 - (1 - lower_half_ratio) * cos(22.5 deg)) * tan(pavilion_angle)"}],
 ["variable.set", {"name": "crown_unit_volume", "expr": "8 * (table_ratio^2 * sin(45 deg) / 2 * crown_rise + table_ratio * sin(22.5 deg) * (star_point - table_ratio * cos(22.5 deg)) * (2 * crown_rise + star_rise) / 3 + (1 - table_ratio) * star_point * sin(22.5 deg) * (crown_rise + star_rise) / 3 + (1 - star_point) * sin(22.5 deg) * star_rise / 3)"}],
 ["variable.set", {"name": "pavilion_unit_volume", "expr": "8 * sin(22.5 deg) * (lower_drop + (1 - lower_half_ratio) * tan(pavilion_angle)) / 3"}],
 ["variable.set", {"name": "girdle_unit_volume", "expr": "2 * pi * girdle_ratio - 16 * (2 / 3 * sin(11.25 deg)^3 - cos(11.25 deg) * (pi / 16 - sin(11.25 deg) * cos(11.25 deg))) * (star_rise / (1 - star_point) + lower_drop / lower_half_ratio) / cos(11.25 deg)"}],
 ["variable.set", {"name": "stone_radius", "expr": "pow(carat * 0.2 g / diamond_density / (1 mm)^3 / (crown_unit_volume + pavilion_unit_volume + girdle_unit_volume), 1 / 3) * 1 mm"}],
 ["variable.set", {"name": "girdle_half_thickness", "expr": "girdle_ratio * stone_radius"}],
 ["variable.set", {"name": "table_height", "expr": "girdle_half_thickness + crown_rise * stone_radius"}],
 ["variable.set", {"name": "star_radius", "expr": "star_point * stone_radius"}],
 ["variable.set", {"name": "star_height", "expr": "girdle_half_thickness + star_rise * stone_radius"}],
 ["variable.set", {"name": "lower_depth", "expr": "girdle_half_thickness + lower_drop * stone_radius"}],
 ["variable.set", {"name": "culet_depth", "expr": "girdle_half_thickness + stone_radius * tan(pavilion_angle)"}],
 ["variable.set", {"name": "cutter_reach", "expr": "3 * stone_radius"}],
 ["variable.set", {"name": "inner_radius", "expr": "ring_size * 1 mm / (2 * pi)"}],
 ["variable.set", {"name": "band_ratio", "expr": "0.32"}],
 ["variable.set", {"name": "band_width", "expr": "max(2.2 mm, band_ratio * 2 * stone_radius)"}],
 ["variable.set", {"name": "band_thickness", "expr": "1.7 mm"}],
 ["variable.set", {"name": "band_edge_radius", "expr": "0.4 mm"}],
 ["variable.set", {"name": "band_crown_radius", "expr": "((band_width / 2 - band_edge_radius)^2 + (band_thickness / 2)^2 - band_edge_radius^2) / (2 * (band_thickness / 2 - band_edge_radius))"}],
 ["variable.set", {"name": "band_centre", "expr": "inner_radius + band_thickness / 2"}],
 ["variable.set", {"name": "band_tangent_u", "expr": "(band_crown_radius - band_thickness / 2) * band_edge_radius / (band_crown_radius - band_edge_radius)"}],
 ["variable.set", {"name": "band_tangent_v", "expr": "band_crown_radius * (band_width / 2 - band_edge_radius) / (band_crown_radius - band_edge_radius)"}],
 ["variable.set", {"name": "prong_ratio", "expr": "0.17"}],
 ["variable.set", {"name": "seat_fraction", "expr": "1 / 3"}],
 ["variable.set", {"name": "prong_diameter", "expr": "max(prong_ratio * 2 * stone_radius, 1 mm)"}],
 ["variable.set", {"name": "prong_offset", "expr": "(stone_radius + prong_diameter / 2 - seat_fraction * prong_diameter) * sin(45 deg)"}],
 ["variable.set", {"name": "culet_clearance", "expr": "0.5 mm"}],
 ["variable.set", {"name": "basket_bottom", "expr": "sqrt((inner_radius + band_thickness)^2 - prong_offset^2)"}],
 ["variable.set", {"name": "gallery_ratio", "expr": "0.6"}],
 ["variable.set", {"name": "gallery_wire", "expr": "max(gallery_ratio * prong_diameter, 0.8 mm)"}],
 ["variable.set", {"name": "setting_gap", "expr": "0.1 mm"}],
 ["variable.set", {"name": "joint_ratio", "expr": "0.2"}],
 ["variable.set", {"name": "girdle_height", "expr": "max(inner_radius + band_thickness + culet_clearance + culet_depth, basket_bottom + prong_offset + girdle_half_thickness + setting_gap + gallery_wire + 2 * joint_ratio * prong_diameter)"}],
 ["variable.set", {"name": "prong_tip_height", "expr": "girdle_height + girdle_half_thickness + seat_fraction * prong_diameter * tan(crown_angle)"}],
 ["feature.cylinder", {"radius": "stone_radius", "height": "culet_depth + table_height + girdle_half_thickness", "position": [0, 0, "-culet_depth - girdle_half_thickness"], "name": "Bruted blank"}],
 ["datum.plane", {"through": [["stone_radius", 0, "girdle_half_thickness"], ["star_radius * cos(22.5 deg)", "star_radius * sin(22.5 deg)", "star_height"], ["star_radius * cos(22.5 deg)", "-star_radius * sin(22.5 deg)", "star_height"]], "name": "Bezel plane"}],
 ["sketch.create", {"plane": "Bezel plane", "name": "Bezel sketch"}],
 ["sketch.rect", {"sketch": "Bezel sketch", "from": ["-cutter_reach", "-cutter_reach"], "to": ["cutter_reach", "cutter_reach"]}],
 ["feature.extrude", {"sketch": "Bezel sketch", "distance": "cutter_reach", "name": "Bezel cutter"}],
 ["feature.pattern", {"source": "Bezel cutter", "count": "8", "angle": "45 deg", "name": "Bezel cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Bruted blank", "tool": "Bezel cutters", "name": "Bezel facets"}],
 ["datum.plane", {"through": [["star_radius * cos(22.5 deg)", "star_radius * sin(22.5 deg)", "star_height"], ["stone_radius", 0, "girdle_half_thickness"], ["stone_radius * cos(22.5 deg)", "stone_radius * sin(22.5 deg)", "girdle_half_thickness"]], "name": "Upper girdle plane"}],
 ["sketch.create", {"plane": "Upper girdle plane", "name": "Upper girdle sketch"}],
 ["sketch.rect", {"sketch": "Upper girdle sketch", "from": ["-cutter_reach", "-cutter_reach"], "to": ["cutter_reach", "cutter_reach"]}],
 ["feature.extrude", {"sketch": "Upper girdle sketch", "distance": "cutter_reach", "name": "Upper girdle cutter"}],
 ["feature.pattern", {"source": "Upper girdle cutter", "count": "8", "angle": "45 deg", "name": "Upper girdle cutters"}],
 ["feature.mirror", {"source": "Upper girdle cutters", "normal": ["-sin(22.5 deg)", "cos(22.5 deg)", 0], "keep": true, "name": "Mirrored upper girdle cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Bezel facets", "tool": "Upper girdle cutters", "name": "Upper girdle facets"}],
 ["feature.boolean", {"op": "subtract", "target": "Upper girdle facets", "tool": "Mirrored upper girdle cutters", "name": "Mirrored upper girdle facets"}],
 ["datum.plane", {"through": [["table_ratio * stone_radius", 0, "table_height"], ["star_radius * cos(22.5 deg)", "star_radius * sin(22.5 deg)", "star_height"], ["table_ratio * stone_radius * cos(45 deg)", "table_ratio * stone_radius * sin(45 deg)", "table_height"]], "name": "Star plane"}],
 ["sketch.create", {"plane": "Star plane", "name": "Star sketch"}],
 ["sketch.rect", {"sketch": "Star sketch", "from": ["-cutter_reach", "-cutter_reach"], "to": ["cutter_reach", "cutter_reach"]}],
 ["feature.extrude", {"sketch": "Star sketch", "distance": "cutter_reach", "name": "Star cutter"}],
 ["feature.pattern", {"source": "Star cutter", "count": "8", "angle": "45 deg", "name": "Star cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Mirrored upper girdle facets", "tool": "Star cutters", "name": "Star facets"}],
 ["datum.plane", {"through": [["stone_radius", 0, "-girdle_half_thickness"], ["(1 - lower_half_ratio) * stone_radius * cos(22.5 deg)", "-(1 - lower_half_ratio) * stone_radius * sin(22.5 deg)", "-lower_depth"], ["(1 - lower_half_ratio) * stone_radius * cos(22.5 deg)", "(1 - lower_half_ratio) * stone_radius * sin(22.5 deg)", "-lower_depth"]], "name": "Pavilion plane"}],
 ["sketch.create", {"plane": "Pavilion plane", "name": "Pavilion sketch"}],
 ["sketch.rect", {"sketch": "Pavilion sketch", "from": ["-cutter_reach", "-cutter_reach"], "to": ["cutter_reach", "cutter_reach"]}],
 ["feature.extrude", {"sketch": "Pavilion sketch", "distance": "cutter_reach", "name": "Pavilion cutter"}],
 ["feature.pattern", {"source": "Pavilion cutter", "count": "8", "angle": "45 deg", "name": "Pavilion cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Star facets", "tool": "Pavilion cutters", "name": "Pavilion main facets"}],
 ["datum.plane", {"through": [["(1 - lower_half_ratio) * stone_radius * cos(22.5 deg)", "(1 - lower_half_ratio) * stone_radius * sin(22.5 deg)", "-lower_depth"], ["stone_radius * cos(22.5 deg)", "stone_radius * sin(22.5 deg)", "-girdle_half_thickness"], ["stone_radius", 0, "-girdle_half_thickness"]], "name": "Lower girdle plane"}],
 ["sketch.create", {"plane": "Lower girdle plane", "name": "Lower girdle sketch"}],
 ["sketch.rect", {"sketch": "Lower girdle sketch", "from": ["-cutter_reach", "-cutter_reach"], "to": ["cutter_reach", "cutter_reach"]}],
 ["feature.extrude", {"sketch": "Lower girdle sketch", "distance": "cutter_reach", "name": "Lower girdle cutter"}],
 ["feature.pattern", {"source": "Lower girdle cutter", "count": "8", "angle": "45 deg", "name": "Lower girdle cutters"}],
 ["feature.mirror", {"source": "Lower girdle cutters", "normal": ["-sin(22.5 deg)", "cos(22.5 deg)", 0], "keep": true, "name": "Mirrored lower girdle cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Pavilion main facets", "tool": "Lower girdle cutters", "name": "Lower girdle facets"}],
 ["feature.boolean", {"op": "subtract", "target": "Lower girdle facets", "tool": "Mirrored lower girdle cutters", "name": "Mirrored lower girdle facets"}],
 ["feature.transform", {"source": "Mirrored lower girdle facets", "translate": [0, 0, "girdle_height"], "name": "Diamond"}],
 ["feature.cylinder", {"radius": "inner_radius", "height": "2 * band_width", "position": [0, "-band_width", 0], "axis": [0, 1, 0], "name": "Ring gauge"}],
 ["feature.visible", {"feature": "Ring gauge", "visible": false}],
 ["sketch.create", {"plane": "xy", "name": "Band section"}],
 ["sketch.path", {"sketch": "Band section", "start": ["band_centre + band_tangent_u", "-band_tangent_v"], "segments": [{"arc": ["band_centre + band_tangent_u", "band_tangent_v"], "center": ["band_centre - band_crown_radius + band_thickness / 2", 0]}, {"arc": ["band_centre - band_tangent_u", "band_tangent_v"], "center": ["band_centre", "band_width / 2 - band_edge_radius"]}, {"arc": ["band_centre - band_tangent_u", "-band_tangent_v"], "center": ["band_centre + band_crown_radius - band_thickness / 2", 0]}, {"arc": "start", "center": ["band_centre", "band_edge_radius - band_width / 2"]}]}],
 ["feature.revolve", {"sketch": "Band section", "axis": "y", "name": "Shank"}],
 ["sketch.create", {"plane": "xy", "offset": "prong_tip_height", "name": "Prong section"}],
 ["sketch.circle", {"sketch": "Prong section", "center": ["prong_offset", "-prong_offset"], "radius": "prong_diameter / 2"}],
 ["sketch.create", {"plane": "yz", "offset": "prong_offset", "name": "Prong pair path"}],
 ["sketch.path", {"sketch": "Prong pair path", "start": ["-prong_offset", "prong_tip_height"], "segments": [{"line": ["-prong_offset", "basket_bottom + prong_offset"]}, {"arc": ["prong_offset", "basket_bottom + prong_offset"], "center": [0, "basket_bottom + prong_offset"]}, {"line": ["prong_offset", "prong_tip_height"]}]}],
 ["feature.sweep", {"sketch": "Prong section", "path": "Prong pair path", "name": "Prong pair"}],
 ["feature.pattern", {"source": "Prong pair", "count": "2", "angle": "180 deg", "name": "Prong pairs"}],
 ["feature.sphere", {"radius": "prong_diameter / 2", "position": ["prong_offset", "prong_offset", "prong_tip_height"], "name": "Prong tip"}],
 ["feature.pattern", {"source": "Prong tip", "count": "4", "angle": "90 deg", "name": "Prong tips"}],
 ["feature.boolean", {"op": "union", "target": "Prong pairs", "tool": "Prong tips", "name": "Prongs"}],
 ["feature.boolean", {"op": "subtract", "target": "Prongs", "tool": "Diamond", "keepTool": true, "name": "Prong seats"}],
 ["feature.torus", {"major": "stone_radius + gallery_wire / 2 + setting_gap", "minor": "gallery_wire / 2", "position": [0, 0, "girdle_height - girdle_half_thickness - gallery_wire / 2 - setting_gap"], "name": "Gallery"}],
 ["feature.boolean", {"op": "union", "target": "Prong seats", "tool": "Gallery", "name": "Head"}],
 ["feature.fillet", {"edges": [["F43:face(0)", "F38:copy(0)/F37:side(e2,e3)"], ["F43:face(0)", "F38:copy(0)/F37:side(e2,e8)"], ["F43:face(0)", "F38:copy(1)/F37:side(e2,e3)"], ["F43:face(0)", "F38:copy(1)/F37:side(e2,e8)"]], "radius": "joint_ratio * prong_diameter", "name": "Gallery joints"}],
 ["feature.boolean", {"op": "union", "target": "Shank", "tool": "Gallery joints", "name": "Head on shank"}],
 ["feature.fillet", {"edges": [["F34:side(e4)", "F38:copy(0)/F37:side(e2,e6)"], ["F34:side(e4)", "F38:copy(1)/F37:side(e2,e6)"]], "radius": "joint_ratio * prong_diameter", "name": "Ring", "when": "carat <= 1.2"}],
 ["material.preset", {"body": "Ring", "preset": "steel", "color": "#f5d9a0", "metallic": 1, "roughness": 0.12}],
 ["body.material", {"body": "Ring", "name": "18 ct yellow gold (750, equal silver and copper)", "density": "15.4 g/cm3"}],
 ["material.preset", {"body": "Diamond", "preset": "glass", "color": "#ffffff", "metallic": 0.55, "roughness": 0, "clearcoat": 1, "clearcoatRoughness": 0, "transmission": 0.15, "ior": 2.417, "absorption": "#ffffff", "absorptionDistance": 10}],
 ["body.material", {"body": "Diamond", "name": "Diamond", "density": "diamond_density * (1 m)^3 / (1 kg)"}],
 ["variable.measure", {"name": "gold_mass", "measure": "mass", "of": "Ring", "label": "Gold", "unit": "g"}],
 ["variable.measure", {"name": "stone_width", "measure": "extent", "of": "Diamond", "axis": "x", "label": "Stone diameter"}],
 ["variable.measure", {"name": "stone_depth", "measure": "extent", "of": "Diamond", "axis": "z", "label": "Stone depth"}],
 ["assert.add", {"name": "Ring size to ISO 8653", "measure": "clearance", "from": "Ring gauge", "to": "Ring", "eq": "0 mm", "tol": "0.0001 mm"}],
 ["assert.add", {"name": "Diamond weighs its carat", "measure": "mass", "of": "Diamond", "eq": "carat * 0.2 g", "tol": "carat * 0.2 g / 1000000"}],
 ["assert.add", {"name": "Round brilliant of 57 facets", "measure": "count", "of": {"kind": "face", "where": {"in": "Diamond", "surface": "plane"}}, "eq": "57"}],
 ["assert.add", {"name": "Weight by the trade's estimate", "measure": "value", "expr": "stone_width^2 * stone_depth / (1 mm)^3 * 0.0061", "min": "0.97 * carat", "max": "1.03 * carat"}],
 ["assert.add", {"name": "Shank volume by Pappus", "measure": "volumeBelow", "of": "Ring", "plane": "xy", "eq": "pi * band_centre * (2 * atan2(band_width / 2 - band_edge_radius, band_crown_radius - band_thickness / 2) / (1 rad) * band_crown_radius^2 + (pi - 2 * atan2(band_width / 2 - band_edge_radius, band_crown_radius - band_thickness / 2) / (1 rad)) * band_edge_radius^2 - 2 * (band_crown_radius - band_thickness / 2) * (band_width / 2 - band_edge_radius))", "tol": "0.001"}],
 ["assert.add", {"name": "Gallery clear of the stone", "measure": "distance", "from": "Diamond", "to": {"kind": "face", "where": {"in": "Ring", "madeBy": "Gallery"}}, "min": "setting_gap"}],
 ["assert.add", {"name": "Culet above the shank", "measure": "distance", "from": "Diamond", "to": {"kind": "face", "where": {"in": "Ring", "madeBy": "Shank"}}, "min": "culet_clearance"}],
 ["assert.add", {"name": "Castable wire, 0.8 mm or more", "measure": "value", "expr": "min(prong_diameter, gallery_wire)", "min": "0.8 mm"}],
 ["document.info", {"title": "Solitaire ring", "description": "An 18 ct yellow-gold solitaire in ISO 8653 ring sizes 44 to 72: a comfort-fit court shank and a four-prong basket head holding a round brilliant cut to Tolkowsky's proportions, 0.25 to 2 ct, sized from its weight.", "author": "3DCraft examples", "licence": "MIT", "tags": ["jewellery", "ring", "diamond", "ISO 8653"]}],
 ["document.check", {}]
