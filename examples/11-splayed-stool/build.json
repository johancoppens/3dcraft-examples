[
 ["variable.set", {"name": "seat_height", "expr": "450 mm"}],
 ["variable.set", {"name": "splay_angle", "expr": "10 deg"}],
 ["variable.publish", {"name": "seat_height", "label": "Seat height", "description": "Height of the seat's top above the floor", "group": "Stool", "order": 1, "min": "400 mm", "max": "650 mm", "step": "10 mm"}],
 ["variable.publish", {"name": "splay_angle", "label": "Splay angle", "description": "How far each leg leans out, seen from the front and seen from the side (splay and rake are equal)", "group": "Stool", "order": 2, "min": "5 deg", "max": "12 deg", "step": "0.5 deg"}],
 ["variable.set", {"name": "seat_diameter", "expr": "340 mm"}],
 ["variable.set", {"name": "seat_thickness", "expr": "30 mm"}],
 ["variable.set", {"name": "seat_round_over", "expr": "6 mm"}],
 ["variable.set", {"name": "seat_bevel_rise", "expr": "6 mm"}],
 ["variable.set", {"name": "seat_bevel_width", "expr": "12 mm"}],
 ["variable.set", {"name": "leg_width", "expr": "38 mm"}],
 ["variable.set", {"name": "leg_arris", "expr": "3 mm"}],
 ["variable.set", {"name": "foot_chamfer", "expr": "2 mm"}],
 ["variable.set", {"name": "tenon_offset", "expr": "80 mm"}],
 ["variable.set", {"name": "through_tenon", "expr": "leg_width / 2"}],
 ["variable.set", {"name": "wedge_width", "expr": "4 mm"}],
 ["variable.set", {"name": "wedge_depth", "expr": "2 * seat_thickness / 3"}],
 ["variable.set", {"name": "stretcher_height_ratio", "expr": "0.4"}],
 ["variable.set", {"name": "stretcher_height", "expr": "stretcher_height_ratio * seat_height"}],
 ["variable.set", {"name": "stretcher_thickness", "expr": "22 mm"}],
 ["variable.set", {"name": "stretcher_depth", "expr": "32 mm"}],
 ["variable.set", {"name": "stretcher_round", "expr": "3 mm"}],
 ["variable.set", {"name": "stretcher_tenon", "expr": "leg_width / 3"}],
 ["variable.set", {"name": "stretcher_shoulder", "expr": "5 mm"}],
 ["variable.set", {"name": "tenon_height", "expr": "stretcher_depth - 2 * stretcher_shoulder"}],
 ["variable.set", {"name": "mortise_depth", "expr": "2 * leg_width / 3"}],
 ["variable.set", {"name": "trim_allowance", "expr": "40 mm"}],
 ["variable.set", {"name": "leg_tilt", "expr": "atan(sqrt(2) * tan(splay_angle))"}],
 ["variable.set", {"name": "leg_frame_major", "expr": "leg_width * (1 + cos(leg_tilt)) / 2"}],
 ["variable.set", {"name": "leg_frame_minor", "expr": "leg_width * (1 - cos(leg_tilt)) / 2"}],
 ["variable.set", {"name": "leg_frame_rise", "expr": "leg_width * sin(leg_tilt) / sqrt(2)"}],
 ["variable.set", {"name": "leg_frame_axial", "expr": "leg_width * cos(leg_tilt)"}],
 ["variable.set", {"name": "axis_below_floor", "expr": "tenon_offset + (seat_height + trim_allowance) * tan(splay_angle)"}],
 ["variable.set", {"name": "axis_at_stretcher", "expr": "tenon_offset + (seat_height - stretcher_height) * tan(splay_angle)"}],
 ["variable.set", {"name": "stretcher_reach", "expr": "axis_at_stretcher - leg_width / (1 + cos(leg_tilt)) + mortise_depth"}],
 ["variable.set", {"name": "leg_section_area", "expr": "leg_width^2 - 2 * leg_arris^2"}],
 ["variable.set", {"name": "stretcher_section_area", "expr": "stretcher_thickness * stretcher_depth - (4 - pi) * stretcher_round^2"}],
 ["variable.set", {"name": "foot_zone", "expr": "10 mm"}],
 ["variable.set", {"name": "contact_section_height", "expr": "0.001 mm"}],
 ["variable.set", {"name": "test_load", "expr": "600 N"}],
 ["variable.set", {"name": "test_load_inset", "expr": "50 mm"}],
 ["variable.set", {"name": "test_push", "expr": "20 N"}],
 ["variable.set", {"name": "standard_gravity", "expr": "9.80665 N / (1 kg)"}],
 ["variable.set", {"name": "tilt_test_travel", "expr": "100 mm"}],
 ["variable.set", {"name": "least_mortise_wall", "expr": "7 mm"}],
 ["feature.cylinder", {"radius": "seat_diameter / 2", "height": "seat_thickness", "position": [0, 0, "seat_height - seat_thickness"], "name": "Seat blank"}],
 ["feature.fillet", {"edges": [["F1:face(0)", "F1:face(2)"]], "radius": "seat_round_over", "name": "Seat round-over"}],
 ["feature.chamfer", {"edges": [["F1:face(0)", "F1:face(1)"]], "distance": "seat_bevel_rise", "second": "seat_bevel_width", "name": "Seat underside bevel"}],
 ["datum.plane", {"through": [["axis_below_floor", "axis_below_floor", "-trim_allowance"], ["axis_below_floor + leg_frame_major", "axis_below_floor - leg_frame_minor", "leg_frame_rise - trim_allowance"], ["axis_below_floor - leg_frame_minor", "axis_below_floor + leg_frame_major", "leg_frame_rise - trim_allowance"]], "name": "Leg square end"}],
 ["sketch.create", {"name": "Leg section", "plane": "Leg square end"}],
 ["sketch.rect", {"sketch": "Leg section", "from": ["-leg_width / 2", "-leg_width / 2"], "to": ["leg_width / 2", "leg_width / 2"]}],
 ["feature.extrude", {"sketch": "Leg section", "distance": "(seat_height + 2 * trim_allowance) / cos(leg_tilt)", "name": "Leg stock"}],
 ["feature.chamfer", {"edges": [["F6:side(e5)", "F6:side(e6)"], ["F6:side(e6)", "F6:side(e7)"], ["F6:side(e7)", "F6:side(e8)"], ["F6:side(e8)", "F6:side(e5)"]], "distance": "leg_arris", "name": "Leg arrises"}],
 ["sketch.create", {"name": "Through tenon section", "plane": "Leg square end"}],
 ["sketch.rect", {"sketch": "Through tenon section", "from": ["-through_tenon / 2", "-through_tenon / 2"], "to": ["through_tenon / 2", "through_tenon / 2"]}],
 ["feature.extrude", {"sketch": "Through tenon section", "distance": "(seat_height + 2 * trim_allowance) / cos(leg_tilt)", "name": "Seat mortise cutter"}],
 ["feature.pattern", {"source": "Seat mortise cutter", "count": 4, "angle": "90 deg", "name": "Seat mortise cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Seat underside bevel", "tool": "Seat mortise cutters", "name": "Seat"}],
 ["feature.boolean", {"op": "subtract", "target": "Leg arrises", "tool": "Seat", "keepTool": true, "name": "Leg with through tenon"}],
 ["feature.block", {"size": ["2 * (axis_below_floor + leg_width)", "2 * (axis_below_floor + leg_width)", "seat_height"], "position": ["-axis_below_floor - leg_width", "-axis_below_floor - leg_width", 0], "name": "Floor to seat top"}],
 ["feature.boolean", {"op": "intersect", "target": "Leg with through tenon", "tool": "Floor to seat top", "name": "Leg cut level and flush"}],
 ["feature.chamfer", {"edges": [["F14:copy(1)/F13:face(0)", "F14:copy(0)/F6:side(e5)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F6:side(e6)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F6:side(e7)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F6:side(e8)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F7:chamfer(0)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F7:chamfer(1)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F7:chamfer(2)"], ["F14:copy(1)/F13:face(0)", "F14:copy(0)/F7:chamfer(3)"]], "distance": "foot_chamfer", "name": "Foot chamfer"}],
 ["feature.pattern", {"source": "Foot chamfer", "count": 4, "angle": "90 deg", "name": "Four legs"}],
 ["sketch.create", {"name": "Stretcher elevation", "plane": "yz", "offset": "axis_at_stretcher"}],
 ["sketch.rect", {"sketch": "Stretcher elevation", "from": ["-stretcher_reach", "stretcher_height - stretcher_depth / 2"], "to": ["stretcher_reach", "stretcher_height + stretcher_depth / 2"]}],
 ["feature.extrude", {"sketch": "Stretcher elevation", "distance": "stretcher_thickness", "symmetric": true, "name": "Stretcher stock"}],
 ["feature.fillet", {"edges": [["F18:side(e5)", "F18:startCap(e5,e6,e7,e8)"], ["F18:side(e5)", "F18:endCap(e5,e6,e7,e8)"], ["F18:side(e7)", "F18:startCap(e5,e6,e7,e8)"], ["F18:side(e7)", "F18:endCap(e5,e6,e7,e8)"]], "radius": "stretcher_round", "name": "Stretcher round-over"}],
 ["sketch.create", {"name": "Stretcher tenon elevation", "plane": "yz", "offset": "axis_at_stretcher"}],
 ["sketch.rect", {"sketch": "Stretcher tenon elevation", "from": ["-stretcher_reach", "stretcher_height - tenon_height / 2"], "to": ["stretcher_reach", "stretcher_height + tenon_height / 2"]}],
 ["feature.extrude", {"sketch": "Stretcher tenon elevation", "distance": "stretcher_tenon", "symmetric": true, "name": "Leg mortise cutter"}],
 ["feature.pattern", {"source": "Stretcher round-over", "count": 2, "angle": "180 deg", "name": "Stretcher pair"}],
 ["feature.pattern", {"source": "Leg mortise cutter", "count": 2, "angle": "180 deg", "name": "Leg mortise cutters"}],
 ["feature.boolean", {"op": "subtract", "target": "Four legs", "tool": "Leg mortise cutters", "name": "Mortised legs"}],
 ["feature.boolean", {"op": "subtract", "target": "Stretcher pair", "tool": "Mortised legs", "keepTool": true, "name": "Stretchers"}],
 ["datum.plane", {"through": [["tenon_offset", "tenon_offset", "seat_height"], ["tenon_offset + leg_frame_major", "tenon_offset - leg_frame_minor", "seat_height + leg_frame_rise"], ["tenon_offset - leg_frame_rise", "tenon_offset - leg_frame_rise", "seat_height + leg_frame_axial"]], "name": "Wedge plane"}],
 ["sketch.create", {"name": "Wedge section", "plane": "Wedge plane"}],
 ["sketch.polyline", {"sketch": "Wedge section", "closed": true, "points": [[0, "-wedge_depth"], ["wedge_width / 2 * (wedge_depth + trim_allowance) / wedge_depth", "trim_allowance"], ["-wedge_width / 2 * (wedge_depth + trim_allowance) / wedge_depth", "trim_allowance"]]}],
 ["feature.extrude", {"sketch": "Wedge section", "distance": "2 * through_tenon", "symmetric": true, "name": "Wedge stock"}],
 ["feature.pattern", {"source": "Wedge stock", "count": 2, "angle": "180 deg", "name": "Wedge stock pair"}],
 ["feature.mirror", {"source": "Wedge stock pair", "normal": [1, 0, 0], "keep": true, "name": "Mirrored wedge stock pair"}],
 ["feature.boolean", {"op": "union", "target": "Wedge stock pair", "tool": "Mirrored wedge stock pair", "name": "Four wedge stocks"}],
 ["feature.boolean", {"op": "intersect", "target": "Four wedge stocks", "tool": "Mortised legs", "keepTool": true, "name": "Wedges"}],
 ["feature.boolean", {"op": "subtract", "target": "Mortised legs", "tool": "Wedges", "keepTool": true, "name": "Wedged legs"}],
 ["feature.block", {"size": ["axis_below_floor + leg_width", "axis_below_floor + leg_width", "seat_height + 2 * trim_allowance"], "position": ["tenon_offset / 2", "tenon_offset / 2", "-trim_allowance"], "name": "Back right quadrant"}],
 ["feature.pattern", {"source": "Back right quadrant", "count": 2, "angle": "180 deg", "name": "Back right and front left quadrants"}],
 ["feature.boolean", {"op": "intersect", "target": "Back right and front left quadrants", "tool": "Wedged legs", "keepTool": true, "name": "Legs, back right and front left"}],
 ["feature.block", {"size": ["axis_below_floor + leg_width", "axis_below_floor + leg_width", "seat_height + 2 * trim_allowance"], "position": ["-axis_below_floor - leg_width - tenon_offset / 2", "tenon_offset / 2", "-trim_allowance"], "name": "Back left quadrant"}],
 ["feature.pattern", {"source": "Back left quadrant", "count": 2, "angle": "180 deg", "name": "Back left and front right quadrants"}],
 ["feature.boolean", {"op": "intersect", "target": "Back left and front right quadrants", "tool": "Wedged legs", "name": "Legs, back left and front right"}],
 ["material.preset", {"body": "Seat", "preset": "oak", "roughness": 0.5, "subsurface": 0.12, "subsurfaceColor": "#a8703e", "pattern": {"colors": ["#a98861", "#977651", "#7d6043"], "scale": 6, "axis": [1, 0, 0], "distortion": 0.2, "grain": 0.6, "rays": 0.6, "roughness": [0.48, 0.55]}}],
 ["material.preset", {"body": "Legs, back right and front left", "preset": "oak", "roughness": 0.5, "subsurface": 0.12, "subsurfaceColor": "#a8703e", "pattern": {"colors": ["#a98861", "#977651", "#7d6043"], "scale": 6, "axis": [0, 0, 1], "origin": [3000, -3000, 0], "distortion": 0.2, "grain": 0.6, "rays": 0.2, "roughness": [0.48, 0.55]}}],
 ["material.preset", {"body": "Legs, back left and front right", "preset": "oak", "roughness": 0.5, "subsurface": 0.12, "subsurfaceColor": "#a8703e", "pattern": {"colors": ["#a98861", "#977651", "#7d6043"], "scale": 6, "axis": [0, 0, 1], "origin": [3000, 3000, 0], "distortion": 0.2, "grain": 0.6, "rays": 0.2, "roughness": [0.48, 0.55]}}],
 ["material.preset", {"body": "Stretchers", "preset": "oak", "roughness": 0.5, "subsurface": 0.12, "subsurfaceColor": "#a8703e", "pattern": {"colors": ["#a98861", "#977651", "#7d6043"], "scale": 6, "axis": [0, 1, 0], "distortion": 0.2, "grain": 0.6, "rays": 0.6, "roughness": [0.48, 0.55]}}],
 ["material.preset", {"body": "Wedges", "preset": "walnut", "roughness": 0.5, "pattern": {"axis": [0, 1, 0]}}],
 ["variable.measure", {"name": "seat_volume", "measure": "volume", "of": "Seat", "label": "Seat volume"}],
 ["variable.measure", {"name": "legs_volume", "measure": "volume", "of": ["Legs, back right and front left", "Legs, back left and front right"], "label": "Legs volume"}],
 ["variable.measure", {"name": "feet_volume", "measure": "volumeBelow", "of": ["Legs, back right and front left", "Legs, back left and front right"], "plane": "xy", "offset": "foot_zone", "label": "Legs volume below the foot zone"}],
 ["variable.measure", {"name": "wedges_volume", "measure": "volume", "of": "Wedges", "label": "Wedges volume"}],
 ["variable.measure", {"name": "stretchers_volume", "measure": "volume", "of": "Stretchers", "label": "Stretchers volume"}],
 ["variable.measure", {"name": "stool_mass", "measure": "mass", "label": "Mass", "unit": "kg"}],
 ["variable.measure", {"name": "foot_span", "measure": "sectionExtent", "of": ["Legs, back right and front left", "Legs, back left and front right"], "plane": "xy", "offset": "contact_section_height", "axis": "x", "label": "Span of the feet on the floor"}],
 ["variable.output", {"name": "stability_margin", "expr": "test_load * (foot_span / 2 - (seat_diameter / 2 - test_load_inset)) + stool_mass * standard_gravity * foot_span / 2 - test_push * seat_height", "label": "Moment left against tipping in the stool test", "unit": "N m"}],
 ["variable.measure", {"name": "centre_of_mass_height", "measure": "centerOfMass", "axis": "z", "label": "Height of the centre of mass"}],
 ["variable.output", {"name": "tilt_test_angle", "expr": "atan((seat_diameter / 2 + foot_span / 2) / seat_height) + asin((tilt_test_travel - seat_diameter / 2 - foot_span / 2) / sqrt((seat_diameter / 2 + foot_span / 2)^2 + seat_height^2))", "label": "Tilt about two feet that moves the far edge of the seat 100 mm", "unit": "deg"}],
 ["variable.output", {"name": "tilt_test_margin", "expr": "foot_span / 2 * cos(tilt_test_angle) - centre_of_mass_height * sin(tilt_test_angle)", "label": "Centre of mass inside the tipping line when so tilted"}],
 ["variable.output", {"name": "leg_resultant_angle", "expr": "leg_tilt", "label": "Leg angle from upright along the sight line", "unit": "deg"}],
 ["variable.output", {"name": "leg_length", "expr": "seat_height / cos(leg_tilt)", "label": "Leg length along its axis, floor to seat top"}],
 ["variable.output", {"name": "leg_blank_length", "expr": "(seat_height + (through_tenon + leg_width - leg_arris) * sin(leg_tilt) / sqrt(2)) / cos(leg_tilt)", "label": "Leg blank along its axis, lowest foot corner to highest tenon corner"}],
 ["variable.output", {"name": "stretcher_length", "expr": "2 * stretcher_reach", "label": "Stretcher length over the tenons"}],
 ["assert.add", {"name": "Seat height", "measure": "extent", "axis": "z", "eq": "seat_height", "tol": "0.001 mm"}],
 ["assert.add", {"name": "Seat with four through mortises at the compound angle", "measure": "value", "expr": "seat_volume", "eq": "pi * (seat_diameter / 2)^2 * seat_thickness - 2 * pi * (seat_diameter / 2 - (10 - 3 * pi) / (12 - 3 * pi) * seat_round_over) * (1 - pi / 4) * seat_round_over^2 - pi * (seat_diameter / 2 - seat_bevel_width / 3) * seat_bevel_rise * seat_bevel_width - 4 * through_tenon^2 * seat_thickness / cos(leg_tilt)", "tol": "0.01"}],
 ["assert.add", {"name": "Legs, through tenons and wedges in closed form", "measure": "value", "expr": "legs_volume - feet_volume + wedges_volume", "eq": "4 * (leg_section_area * (seat_height - seat_thickness - foot_zone) + through_tenon^2 * seat_thickness) / cos(leg_tilt) - 4 * stretcher_tenon * tenon_height * mortise_depth", "tol": "0.01"}],
 ["assert.add", {"name": "Stretchers shouldered on the splayed legs", "measure": "value", "expr": "stretchers_volume", "eq": "2 * (stretcher_section_area * 2 * (axis_at_stretcher - leg_width / (1 + cos(leg_tilt))) + 2 * stretcher_tenon * tenon_height * mortise_depth)", "tol": "0.01"}],
 ["assert.add", {"name": "Wood beside the stretcher mortises", "measure": "distance", "from": {"kind": "face", "where": [{"any": [{"in": "Legs, back right and front left"}, {"in": "Legs, back left and front right"}]}, {"any": [{"name": "*F21:startCap*"}, {"name": "*F21:endCap*"}]}]}, "to": {"kind": "face", "where": [{"any": [{"in": "Legs, back right and front left"}, {"in": "Legs, back left and front right"}]}, {"not": {"name": "*F21:*"}}, {"any": [{"normal": {"along": "x", "tol": 50}}, {"normal": {"along": "-x", "tol": 50}}]}]}, "min": "least_mortise_wall"}],
 ["assert.add", {"name": "Four wedged through tenons", "measure": "count", "of": {"kind": "face", "where": {"in": "Wedges", "name": "*F13:face(1)"}}, "eq": 4}],
 ["assert.add", {"name": "Shoulders clear of the seat bevel", "measure": "distance", "from": ["Legs, back right and front left", "Legs, back left and front right"], "to": {"kind": "face", "where": {"name": "*F3:chamfer(0)"}}, "min": "5 mm"}],
 ["assert.add", {"name": "Stable under the loads of the IS 5416-2 stool test", "measure": "value", "expr": "stability_margin", "min": "0"}],
 ["assert.add", {"name": "Falls back when tilted as the IS 5416-2 stool test asks", "measure": "value", "expr": "tilt_test_margin", "min": "0 mm"}],
 ["document.info", {"title": "Splayed-leg stool", "description": "An oak stool with a round seat on four splayed and raked legs, wedged through-tenons in walnut and two side stretchers, proven in closed form and against the stool stability test.", "author": "3DCraft examples", "licence": "MIT", "tags": ["woodworking", "furniture", "joinery"]}],
 ["document.check", {}]
]
