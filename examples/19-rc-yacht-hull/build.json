 ["table.set", {"name": "hull_stations", "columns": [{"name": "x", "unit": "mm"}, {"name": "sheer_half_breadth", "unit": "mm"}, {"name": "sheer_height", "unit": "mm"}, {"name": "topside_half_breadth", "unit": "mm"}, {"name": "topside_height", "unit": "mm"}, {"name": "bilge_half_breadth", "unit": "mm"}, {"name": "bilge_height", "unit": "mm"}, {"name": "keel_height", "unit": "mm"}], "rows": [[10, 10, 75, 12, 30, 9, -6, -12], [120, 40, 66, 45, 15, 24, -26, -38], [280, 70, 58, 76, 8, 46, -42, -56], [450, 82, 53, 87, 5, 56, -46, -58], [620, 81, 49, 86, 6, 58, -42, -52], [790, 72, 46, 77, 10, 54, -22, -30], [1000, 55, 43, 58, 18, 46, 2, 0.5]]}],
