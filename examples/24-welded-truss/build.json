[
 ["document.setTolerance", {"linear": 0.001}],
 ["table.set", {"name": "chs_sizes", "columns": ["size", {"name": "chord_d", "unit": "mm"}, {"name": "chord_t", "unit": "mm"}, "chord_kg_per_m", {"name": "brace_d", "unit": "mm"}, {"name": "brace_t", "unit": "mm"}, "brace_kg_per_m"], "rows": [["88.9 x 5.0 / 48.3 x 3.2", 88.9, 5.0, 10.3, 48.3, 3.2, 3.56], ["114.3 x 6.3 / 60.3 x 4.0", 114.3, 6.3, 16.8, 60.3, 4.0, 5.55], ["139.7 x 6.3 / 76.1 x 4.0", 139.7, 6.3, 20.7, 76.1, 4.0, 7.11], ["168.3 x 6.3 / 88.9 x 5.0", 168.3, 6.3, 25.2, 88.9, 5.0, 10.3]]}],
 ["variable.set", {"name": "span", "expr": "6000 mm"}],
 ["variable.set", {"name": "depth", "expr": "600 mm"}],
 ["variable.set", {"name": "panel_count", "expr": "6"}],
 ["variable.set", {"name": "section_pair", "expr": "2"}],
 ["variable.publish", {"name": "span", "label": "Span", "description": "Distance between the end nodes of the top chord", "group": "Truss", "order": 1, "min": "4800 mm", "max": "7200 mm", "step": "300 mm"}],
 ["variable.publish", {"name": "depth", "label": "Depth", "description": "Distance between the chord axes, a fourteenth to an eighth of the span", "group": "Truss", "order": 2, "min": "span / 14", "max": "span / 8", "step": "50 mm"}],
 ["variable.publish", {"name": "panel_count", "label": "Panels", "description": "Panels of the top chord, two diagonals each; limited so the diagonals set out on the chord axes lean 30 to 55 degrees", "group": "Truss", "order": 3, "kind": "integer", "min": "max(4, ceil(span * tan(30 deg) / (2 * depth)))", "max": "min(8, floor(span * tan(55 deg) / (2 * depth)))", "step": "1"}],
 ["variable.publish", {"name": "section_pair", "label": "Section pair", "description": "EN 10219-2 circular hollow sections: both chords, then the diagonals", "group": "Truss", "order": 4, "kind": "choice", "choicesFrom": "chs_sizes"}],
 ["variable.set", {"name": "chord_d", "expr": "chs_sizes[section_pair].chord_d"}],
 ["variable.set", {"name": "chord_t", "expr": "chs_sizes[section_pair].chord_t"}],
 ["variable.set", {"name": "brace_d", "expr": "chs_sizes[section_pair].brace_d"}],
 ["variable.set", {"name": "brace_t", "expr": "chs_sizes[section_pair].brace_t"}],
 ["variable.set", {"name": "chord_radius", "expr": "chord_d / 2"}],
 ["variable.set", {"name": "chord_bore", "expr": "chord_d / 2 - chord_t"}],
 ["variable.set", {"name": "brace_radius", "expr": "brace_d / 2"}],
 ["variable.set", {"name": "brace_bore", "expr": "brace_d / 2 - brace_t"}],
 ["variable.set", {"name": "steel_density", "expr": "7850 kg / (1 m)^3"}],
 ["variable.set", {"name": "panel_length", "expr": "span / panel_count"}],
 ["variable.set", {"name": "half_panel", "expr": "panel_length / 2"}],
 ["variable.set", {"name": "yield_strength", "expr": "355 MPa"}],
 ["variable.set", {"name": "tensile_strength", "expr": "470 MPa"}],
 ["variable.set", {"name": "weld_correlation", "expr": "0.9"}],
 ["variable.set", {"name": "weld_partial_factor", "expr": "1.25"}],
 ["variable.set", {"name": "full_strength_ratio", "expr": "sqrt(2) * weld_correlation * yield_strength / tensile_strength * weld_partial_factor"}],
 ["variable.set", {"name": "throat_step", "expr": "0.5 mm"}],
 ["variable.set", {"name": "fillet_weld_max_angle", "expr": "120 deg"}],
 ["variable.set", {"name": "brace_weld_throat", "expr": "ceil(full_strength_ratio * brace_t, throat_step)"}],
 ["variable.set", {"name": "brace_weld_leg", "expr": "brace_weld_throat / cos(fillet_weld_max_angle / 2)"}],
 ["variable.set", {"name": "chord_weld_throat", "expr": "ceil(full_strength_ratio * chord_t, throat_step)"}],
 ["variable.set", {"name": "chord_weld_leg", "expr": "chord_weld_throat * sqrt(2)"}],
 ["variable.set", {"name": "seal_weld_throat", "expr": "3 mm"}],
 ["variable.set", {"name": "seal_weld_leg", "expr": "seal_weld_throat * sqrt(2)"}],
 ["variable.set", {"name": "min_gap", "expr": "2 * (brace_t + brace_weld_leg)"}],
 ["variable.set", {"name": "set_out_angle", "expr": "atan2(depth, half_panel)"}],
 ["variable.set", {"name": "gap_run", "expr": "half_panel - min_gap"}],
 ["variable.set", {"name": "gap_rise", "expr": "depth - chord_d"}],
 ["variable.set", {"name": "gap_angle", "expr": "atan2(gap_rise, gap_run) + asin(brace_d / hypot(gap_run, gap_rise))"}],
 ["variable.set", {"name": "brace_angle", "expr": "max(set_out_angle, gap_angle)"}],
 ["variable.set", {"name": "brace_gap", "expr": "half_panel - (depth - chord_d) / tan(brace_angle) - brace_d / sin(brace_angle)"}],
 ["variable.set", {"name": "eccentricity", "expr": "half_panel / 2 * tan(brace_angle) - depth / 2"}],
 ["variable.set", {"name": "brace_axis_length", "expr": "depth / sin(brace_angle)"}],
 ["variable.set", {"name": "foot_x", "expr": "3 * panel_length / 4 - depth / (2 * tan(brace_angle))"}],
 ["variable.set", {"name": "brace_mitre_length", "expr": "(depth - 2 * sqrt(chord_radius^2 - brace_radius^2)) / sin(brace_angle)"}],
 ["variable.set", {"name": "brace_square_length", "expr": "(depth - 2 * chord_radius + 2 * brace_radius * cos(brace_angle)) / sin(brace_angle)"}],
 ["variable.set", {"name": "end_distance", "expr": "chord_d"}],
 ["variable.set", {"name": "top_chord_length", "expr": "span + 2 * end_distance"}],
 ["variable.set", {"name": "bottom_end_distance", "expr": "brace_gap / 2 + brace_d / sin(brace_angle) + chord_d / 2"}],
 ["variable.set", {"name": "bottom_chord_start", "expr": "half_panel - bottom_end_distance"}],
 ["variable.set", {"name": "bottom_chord_length", "expr": "span - panel_length + 2 * bottom_end_distance"}],
 ["variable.set", {"name": "plate_t", "expr": "15 mm"}],
 ["variable.set", {"name": "bolt_hole_d", "expr": "18 mm"}],
 ["variable.set", {"name": "bolt_square", "expr": "ceil(chord_d + 2 * bolt_hole_d, 5 mm)"}],
 ["variable.set", {"name": "bolt_offset", "expr": "bolt_square / 2"}],
 ["variable.set", {"name": "plate_width", "expr": "ceil(bolt_square + 3 * bolt_hole_d, 10 mm)"}],
 ["variable.set", {"name": "edge_round", "expr": "2 mm"}],
 ["variable.set", {"name": "cap_t", "expr": "8 mm"}],
 ["variable.set", {"name": "cap_d", "expr": "ceil(chord_d + 4 * seal_weld_leg, 1 mm)"}],
 ["variable.set", {"name": "cap_radius", "expr": "cap_d / 2"}],
 ["variable.set", {"name": "chord_area", "expr": "pi * (chord_radius^2 - chord_bore^2)"}],
 ["variable.set", {"name": "brace_area", "expr": "pi * (brace_radius^2 - brace_bore^2)"}],
 ["variable.set", {"name": "ratio_out", "expr": "(brace_radius / chord_radius)^2"}],
 ["variable.set", {"name": "ratio_in", "expr": "(brace_bore / chord_radius)^2"}],
 ["variable.set", {"name": "cope_integral", "expr": "pi * chord_radius * (brace_radius^2 * (1 - ratio_out / 8 - ratio_out^2 / 64 - 5 * ratio_out^3 / 1024 - 35 * ratio_out^4 / 16384 - 147 * ratio_out^5 / 131072 - 693 * ratio_out^6 / 1048576 - 14157 * ratio_out^7 / 33554432) - brace_bore^2 * (1 - ratio_in / 8 - ratio_in^2 / 64 - 5 * ratio_in^3 / 1024 - 35 * ratio_in^4 / 16384 - 147 * ratio_in^5 / 131072 - 693 * ratio_in^6 / 1048576 - 14157 * ratio_in^7 / 33554432))"}],
 ["variable.set", {"name": "diagonal_volume", "expr": "(depth * brace_area - 2 * cope_integral) / sin(brace_angle)"}],
 ["variable.set", {"name": "rim_round_centroid", "expr": "edge_round * (10 - 3 * pi) / (12 - 3 * pi)"}],
 ["variable.set", {"name": "plate_core", "expr": "plate_width - 2 * edge_round"}],
 ["variable.set", {"name": "end_plate_volume", "expr": "plate_core^2 * (plate_t - 2 * edge_round) + 2 * edge_round * (plate_core^2 + 2 * plate_core * (plate_t - 2 * edge_round)) + pi * edge_round^2 * (2 * plate_core + plate_t - 2 * edge_round) + 4 / 3 * pi * edge_round^3 - pi * bolt_hole_d^2 * plate_t"}],
 ["variable.set", {"name": "cap_plate_volume", "expr": "pi * cap_radius^2 * cap_t - 4 * pi * (1 - pi / 4) * edge_round^2 * (cap_radius - rim_round_centroid)"}],
 ["feature.cylinder", {"radius": "chord_radius", "height": "top_chord_length", "position": ["-end_distance", 0, "depth"], "axis": [1, 0, 0], "name": "Top chord envelope"}],
