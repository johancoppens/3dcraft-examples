 ["variable.set", {"name": "minor_diameter", "expr": "thread_diameter - 1.226869 * pitch"}],
 ["variable.set", {"name": "tip_chamfer", "expr": "(thread_diameter - minor_diameter) / 2 + 0.05 * pitch"}],
