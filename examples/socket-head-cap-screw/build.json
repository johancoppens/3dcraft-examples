 ["variable.set", {"name": "pitch", "expr": "iso_4762[size].pitch"}],
 ["variable.set", {"name": "head_diameter", "expr": "iso_4762[size].dk"}],
 ["variable.set", {"name": "head_height", "expr": "iso_4762[size].k"}],
