 ["variable.publish", {"name": "length", "label": "Length", "description": "Nominal length from under the head to the tip, from the ISO 4762 series for this size", "group": "Screw", "order": 2, "kind": "choice", "choicesFrom": "iso_lengths", "min": "iso_4762[size].first_length", "max": "iso_4762[size].last_length"}],
 ["variable.set", {"name": "nominal_length", "expr": "iso_lengths[length].l"}],
