 ["table.set", {"name": "iso_4762", "columns": ["size", {"name": "d", "unit": "mm"}, {"name": "pitch", "unit": "mm"}, {"name": "dk", "unit": "mm"}, {"name": "k", "unit": "mm"}, {"name": "s_min", "unit": "mm"}, {"name": "s_max", "unit": "mm"}, {"name": "t_min", "unit": "mm"}, {"name": "b", "unit": "mm"}, {"name": "r_min", "unit": "mm"}, {"name": "dw_min", "unit": "mm"}, {"name": "full_thread_max", "unit": "mm"}, "first_length", "last_length"], "rows": [["M3", 3, 0.5, 5.5, 3, 2.52, 2.58, 1.3, 18, 0.1, 5.07, 20, 1, 9], ["M4", 4, 0.7, 7, 4, 3.02, 3.08, 2, 20, 0.2, 6.53, 25, 2, 11], ["M5", 5, 0.8, 8.5, 5, 4.02, 4.095, 2.5, 22, 0.2, 8.03, 25, 3, 13], ["M6", 6, 1, 10, 6, 5.02, 5.14, 3, 24, 0.25, 9.38, 30, 4, 15], ["M8", 8, 1.25, 13, 8, 6.02, 6.14, 4, 28, 0.4, 12.33, 35, 5, 18], ["M10", 10, 1.5, 16, 10, 8.025, 8.175, 5, 32, 0.4, 15.33, 40, 6, 20], ["M12", 12, 1.75, 18, 12, 10.025, 10.175, 6, 36, 0.6, 17.23, 50, 7, 22]]}],
