 ["variable.measure", {"name": "clear_span", "measure": "distance", "from": "Side", "to": "Side, right", "label": "Clear span between the sides"}],
 ["variable.output", {"name": "shelf_sag", "expr": "5 * book_load * standard_gravity * clear_span^4 / (384 * plywood_bending_modulus * shelf_depth * sheet_thickness^3 / 12)", "label": "Shelf sag under 30 lb of books per foot, simply supported"}],
 ["variable.output", {"name": "long_term_sag", "expr": "creep_factor * shelf_sag", "label": "Shelf sag after creep (the Sagulator's rule of thumb, 1.5 times)"}],
